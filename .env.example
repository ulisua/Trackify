# Copiá este archivo como .env y completá los valores. .env está en .gitignore.
# URL base donde corre la app (sin barra final). Se usa en los emails.
APP_URL=http://localhost/trackify

# Google OAuth (consola de Google Cloud). La redirect URI debe estar registrada allí.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/trackify/auth/google/callback.php

# SMTP para el envío del código de verificación (por ejemplo, Mailtrap)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trackify.com

# Asistente IA (Groq). Cada integrante usa su propia API key.
GROQ_API_KEY=
