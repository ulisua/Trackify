# Copiá este archivo como .env y completá los valores. .env está en .gitignore.
# Sin .env no se envían los emails de verificación ni funciona el asistente IA.

# URL base donde corre la app (sin barra final). Se usa en los emails.
APP_URL=http://localhost/trackify

# Base de datos (valores por defecto de XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=trackify

# Google OAuth (consola de Google Cloud). La redirect URI debe estar registrada allí.
GOOGLE_CLIENT_ID=936672406949-tqhis3m9sj5g9195pt06394toie25qfp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/trackify/auth/google/callback.php

# SMTP para el código de verificación (Mailtrap: Email Testing > Inboxes > SMTP Settings)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trackify.com

# Asistente IA (Groq). Cada integrante usa su propia API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
