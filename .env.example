# Copiá este archivo como .env y completá los valores. .env está en .gitignore.
# Sin .env no se envían los emails de verificación ni funciona el asistente IA.

# URL base donde corre la app (sin barra final). Se usa en los emails.
APP_URL=http://localhost/trackify

# Base de datos PostgreSQL. Antes: importar trackify_postgres.sql, habilitar
# extension=pdo_pgsql en php.ini (C:\xampp\php\php.ini) y reiniciar Apache.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trackify
DB_USER=postgres
DB_PASS=
# Bases en la nube (Render, Neon, Supabase): en lugar de los DB_* de arriba se puede pegar
# la URL que da el servicio, y en ese caso poner DB_SSLMODE=require.
# DATABASE_URL=postgresql://usuario:clave@host:5432/trackify
DB_SSLMODE=

# Google OAuth (consola de Google Cloud). La redirect URI debe estar registrada allí.
GOOGLE_CLIENT_ID=936672406949-tqhis3m9sj5g9195pt06394toie25qfp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/trackify/auth/google/callback.php

# SMTP para el código de verificación (Mailtrap: Email Testing > Inboxes > SMTP Settings)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trackify.com

# EmailJS (alternativa a SMTP, necesaria en Render que bloquea SMTP). Si estas 4 están
# completas se usa EmailJS en lugar de SMTP. https://dashboard.emailjs.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Asistente IA (Groq). Cada integrante usa su propia API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
